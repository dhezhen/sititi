Options -Indexes

# Aktifkan mod_rewrite
RewriteEngine On
RewriteBase /sititi/

# Arahkan semua request ke index.php (kecuali file/folder yang ada)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]

# Blokir akses langsung ke folder sensitif
RedirectMatch 403 ^/sititi/config/
RedirectMatch 403 ^/sititi/core/
RedirectMatch 403 ^/sititi/models/
RedirectMatch 403 ^/sititi/controllers/

# Keamanan header
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Batasi ukuran upload (10MB)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
</IfModule>
